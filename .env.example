# --- Model ---
ANTHROPIC_API_KEY=sk-ant-...
AGENT_MODEL=claude-opus-5

# --- Elasticsearch ---
ES_URL=https://localhost:9200
ES_API_KEY=
ES_KB_INDEX=support-kb

# --- Retrieval tuning ---
RETRIEVAL_BM25_SIZE=50
RETRIEVAL_KNN_SIZE=50
RETRIEVAL_RRF_K=60
